# Copy this file to .env and fill in both values (no spaces, no quotes).
# Get them at https://developers.deriv.com (see README, step 2).
DERIV_TOKEN=pat_your_personal_access_token_here
DERIV_APP_ID=your_app_id_here

# Optional: your own settings (override the defaults at the top of vera_bot.py).
# Keeping them here means `git pull` never conflicts with your changes.
# VERA_ACCOUNT_TYPE=demo
# VERA_SYMBOL=R_75
# VERA_STAKE=1
# VERA_DRY_RUN=true
# VERA_BANKROLL=50
# VERA_DAILY_STOP_LOSS=10
# VERA_DAILY_TAKE_PROFIT=0     # stop for the day at +X profit (0 = off)
# VERA_BALANCE_TARGET=0        # stop for good when the balance reaches X (0 = off)
# VERA_MARTINGALE=false
# VERA_MAX_OPEN_TRADES=3
# VERA_TREND_TRADE_MINUTES=6
# VERA_WAIT_NEXT_DAY=true
# VERA_CONTRACT=RISEFALL      # RISEFALL, MULTIPLIER, DIGITEVEN, DIGITODD, DIGITMATCH, DIGITDIFF, DIGITOVER, DIGITUNDER, AUTO
# VERA_DIGIT_BARRIER=5
# VERA_DIGIT_TICKS=5
# VERA_TIMEZONE=Africa/Nairobi   # East Africa Time; trading day resets at midnight here
